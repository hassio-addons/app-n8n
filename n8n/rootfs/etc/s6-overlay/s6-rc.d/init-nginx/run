#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: n8n
# Configures NGINX for use with n8n
# ==============================================================================
declare entry
declare port

entry=$(bashio::app.ingress_entry)

# Generate Ingress configuration
bashio::var.json \
    interface "$(bashio::app.ip_address)" \
    port "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access configuration, if enabled.
port=$(bashio::app.port 80)
if bashio::var.has_value "${port}"; then
    bashio::config.require.ssl
    bashio::var.json \
        certfile "$(bashio::config 'certfile')" \
        entry "${entry}" \
        keyfile "$(bashio::config 'keyfile')" \
        port "^80" \
        ssl "^$(bashio::config 'ssl')" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi

# The same server once more, on a port that is never published and never
# encrypted. Home Assistant and the other apps share the internal network
# with this app and reach it there by hostname, which is how an automation
# calls a webhook without a port on the network at all, and without having
# to care whether SSL is on.
bashio::var.json \
    entry "${entry}" \
    port "^5678" \
    ssl "^false" \
    | tempio \
        -template /etc/nginx/templates/direct.gtpl \
        -out /etc/nginx/servers/internal.conf

# The stand-in for Home Assistant that the pre-made credential points at.
if bashio::config.true 'home_assistant_credential'; then
    bashio::var.json \
        port "^48123" \
        | tempio \
            -template /etc/nginx/templates/homeassistant.gtpl \
            -out /etc/nginx/servers/homeassistant.conf
fi
